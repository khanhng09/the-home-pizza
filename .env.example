# Sanity — see the "CMS cho /story (blog) bằng Sanity" plan for context.
# Create a project at sanity.io/manage, dataset "production", then copy
# these into .env.local (gitignored).

# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=
# Pinned, dated API version — see shared/lib/sanity/env.ts. Optional;
# defaults to 2025-02-01 if unset.
# NEXT_PUBLIC_SANITY_API_VERSION=

# Shared secret for Sanity's publish webhook -> /api/revalidate. Generate
# one (e.g. `openssl rand -hex 32`) and paste the same value into the
# webhook's "Secret" field in Sanity's manage console.
# SANITY_REVALIDATE_SECRET=

# No write token needed for local scripts (scripts/seed-sanity-story.ts):
# `yarn sanity login` once, then `yarn sanity exec <script> --with-user-token`
# reuses that session instead.

# Google Tag Manager container ID (e.g. GTM-WK4MZ3XN). Read at build time —
# set it in Netlify's environment variables and redeploy to change it.
# Leave unset locally to keep dev traffic out of analytics.
# NEXT_PUBLIC_GTM_ID=

# Origin /images/* and /videos/* are served from — the R2 bucket's custom
# domain (see shared/lib/media.ts). Read at build time: set it in Netlify's
# environment variables only AFTER `yarn media:upload` has filled the
# bucket, then redeploy. Leave unset locally to serve from public/.
# NEXT_PUBLIC_MEDIA_BASE_URL=https://media.thehomepizza.com

# Used only by `yarn media:upload` (scripts/upload-media-r2.mjs) — never
# add these to Netlify. Token: R2 → Manage API tokens → Object Read &
# Write, scoped to the one bucket.
# R2_ACCOUNT_ID=…
# R2_ACCESS_KEY_ID=…
# R2_SECRET_ACCESS_KEY=…
# R2_BUCKET=…
