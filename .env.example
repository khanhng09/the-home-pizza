# Sanity — see the "CMS cho /story (blog) bằng Sanity" plan for context.
# Create a project at sanity.io/manage, dataset "production", then copy
# these into .env.local (gitignored).

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Pinned, dated API version — see shared/lib/sanity/env.ts. Optional;
# defaults to 2025-02-01 if unset.
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-01

# Shared secret for Sanity's publish webhook -> /api/revalidate. Generate
# one (e.g. `openssl rand -hex 32`) and paste the same value into the
# webhook's "Secret" field in Sanity's manage console.
SANITY_REVALIDATE_SECRET=

# No write token needed for local scripts (scripts/seed-sanity-story.ts):
# `yarn sanity login` once, then `yarn sanity exec <script> --with-user-token`
# reuses that session instead.
